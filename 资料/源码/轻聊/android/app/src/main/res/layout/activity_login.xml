<?xml version="1.0" encoding="utf-8"?>
<!--
  登录 / 注册 / 选择账号。
  三种形态共用这一个布局：
    · 首次使用      → 显示输入表单
    · 有记住密码    → 隐藏表单，显示头像行，点一下就能登录
    · 添加新账号    → 再切回表单
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="44dp"
        android:paddingBottom="24dp">

        <!-- 图标 -->
        <TextView
            android:id="@+id/logo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_logo"
            android:gravity="center"
            android:text="轻"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="轻聊"
            android:textColor="@color/text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="登录后即可收发消息"
            android:textColor="@color/sub"
            android:textSize="13sp" />

        <!-- 账号头像行（选择账号模式） -->
        <LinearLayout
            android:id="@+id/accountRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone" />

        <!-- 输入表单 -->
        <LinearLayout
            android:id="@+id/formBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账号"
                android:textColor="@color/sub"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edUser"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="输入账号"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="密码"
                android:textColor="@color/sub"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edPass"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="输入密码"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/labelNick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="昵称（可选）"
                android:textColor="@color/sub"
                android:textSize="12sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/edNick"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="显示给别人的名字"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbRemember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="记住密码"
                    android:textColor="@color/sub"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbAuto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="18dp"
                    android:text="自动登录"
                    android:textColor="@color/sub"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 选择账号模式下的「自动登录」 -->
        <CheckBox
            android:id="@+id/cbAutoOnly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="自动登录"
            android:textColor="@color/sub"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/danger"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_primary"
            android:text="登录"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/linkSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="6dp"
            android:text="没有账号？立即注册"
            android:textColor="@color/brand"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/linkManage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:padding="6dp"
            android:text="账号管理"
            android:textColor="@color/brand"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="轻聊原生客户端 · Android"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
